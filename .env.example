# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_PACKAGES_SHEET_CSV_URL: Optional Google Sheets URL override for live package management.
# Supports standard Google Sheet /edit links or Publish-to-Web CSV links.
VITE_PACKAGES_SHEET_CSV_URL=""

# VITE_ENQUIRY_WEBHOOK_URL: Optional webhook / Google Apps Script endpoint to store enquiry submissions.
VITE_ENQUIRY_WEBHOOK_URL=""
