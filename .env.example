# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_PACKAGES_SHEET_CSV_URL: Published Google Sheets CSV URL for live package management.
# Publish your sheet via File -> Share -> Publish to web -> Comma-separated values (.csv)
VITE_PACKAGES_SHEET_CSV_URL=""

# VITE_ENQUIRY_WEBHOOK_URL: Optional webhook / Google Apps Script endpoint to store enquiry submissions.
VITE_ENQUIRY_WEBHOOK_URL=""
